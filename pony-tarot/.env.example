# Generate locally with npm run ai:setup. 64 hexadecimal characters; never rotate without migrating encrypted credentials.
MODEL_ENCRYPTION_KEY=
# Set to the exact HTTPS site origin in production (especially behind a reverse proxy).
# APP_ORIGIN=https://your-site.example
# Default SQLite location is .runtime/pony-tarot.sqlite. Use a persistent disk.
# MODEL_DB_PATH=/persistent/pony-tarot.sqlite
